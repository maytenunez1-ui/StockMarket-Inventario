# Copiar como .env en la instancia EC2. Nunca subir este archivo con credenciales.
POSTGRES_DB=stockmarket
POSTGRES_USER=stockmarket
POSTGRES_PASSWORD=REEMPLAZA_CON_UNA_CONTRASENA_LARGA_Y_UNICA
JWT_SECRET=REEMPLAZA_ESTE_VALOR_POR_UN_SECRETO_LARGO_Y_UNICO
# En la base de datos local incluida en Docker se debe mantener en false.
# Cámbialo a true solamente si DATABASE_URL apunta a Amazon RDS u otra base con SSL.
DATABASE_SSL=false
